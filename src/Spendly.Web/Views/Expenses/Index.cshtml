@model ExpenseIndexViewModel
@{
    ViewData["Title"] = "Chi tiêu";
    var result = Model.Result;
    var filter = Model.Filter;
    var hasFilter = filter.From.HasValue || filter.To.HasValue || filter.CategoryId.HasValue || !string.IsNullOrWhiteSpace(filter.Q);

    Func<int, string?> pageUrl = p => Url.Action("Index", new
    {
        @from = filter.From?.ToString("yyyy-MM-dd"),
        to = filter.To?.ToString("yyyy-MM-dd"),
        categoryId = filter.CategoryId,
        q = filter.Q,
        page = p
    });

    var firstPage = Math.Max(1, result.Page - 2);
    var lastPage = Math.Min(result.TotalPages, result.Page + 2);
}

<section class="container-app py-10">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl">Chi Tiêu</h1>
      <p class="mt-1 text-sm">
        @result.TotalCount khoản chi, tổng
        <span class="stat-number text-sm">@MoneyFormatter.Format(result.TotalAmount)</span>
      </p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-pill">+ Thêm khoản chi</a>
  </div>

  @* ----- Bộ lọc ----- *@
  <form method="get" asp-action="Index" class="card mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    <div>
      <label class="label" for="filter-from">Từ ngày</label>
      <input id="filter-from" name="from" type="date" class="input" value="@filter.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
      <label class="label" for="filter-to">Đến ngày</label>
      <input id="filter-to" name="to" type="date" class="input" value="@filter.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
      <label class="label" for="filter-category">Danh mục</label>
      <select id="filter-category" name="categoryId" class="input">
        <option value="">Tất cả danh mục</option>
        @foreach (var option in Model.Categories)
        {
          <option value="@option.Value" selected="@(filter.CategoryId?.ToString() == option.Value)">@option.Text</option>
        }
      </select>
    </div>
    <div>
      <label class="label" for="filter-q">Từ khóa</label>
      <input id="filter-q" name="q" type="search" class="input" placeholder="Ghi chú, danh mục..." value="@filter.Q" />
    </div>
    <div class="flex items-end gap-2">
      <button type="submit" class="btn btn-primary">Lọc</button>
      @if (hasFilter)
      {
        <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
      }
    </div>
  </form>

  @if (result.TotalCount == 0)
  {
    <div class="card mt-6 text-center">
      @if (hasFilter)
      {
        <p class="font-semibold text-ink">Không có khoản chi nào khớp bộ lọc</p>
        <p class="mt-1 text-sm">Thử thay đổi khoảng ngày hoặc từ khóa.</p>
      }
      else
      {
        <p class="font-semibold text-ink">Chưa có khoản chi nào</p>
        <p class="mt-1 text-sm">Bắt đầu bằng việc ghi lại khoản chi đầu tiên của bạn.</p>
        <a asp-action="Create" class="btn btn-primary btn-pill mt-4">Thêm khoản chi đầu tiên</a>
      }
    </div>
  }
  else
  {
    @* ----- Bảng (desktop) ----- *@
    <div class="card mt-6 hidden overflow-x-auto p-0 sm:p-0 md:block">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-line bg-soft text-muted">
          <tr>
            <th class="px-5 py-3 font-medium">Ngày</th>
            <th class="px-5 py-3 font-medium">Danh mục</th>
            <th class="px-5 py-3 font-medium">Ghi chú</th>
            <th class="px-5 py-3 text-right font-medium">Số tiền</th>
            <th class="px-5 py-3 text-right font-medium"><span class="sr-only">Thao tác</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          @foreach (var item in result.Items)
          {
            <tr>
              <td class="whitespace-nowrap px-5 py-3 text-ink">@item.SpentAt.ToString("dd/MM/yyyy")</td>
              <td class="px-5 py-3"><partial name="_CategoryChip" model="new CategoryChipViewModel(item.CategoryName, item.CategoryColor, item.CategoryIcon)" /></td>
              <td class="max-w-xs truncate px-5 py-3">
                @item.Note
                @if (item.IsRecurring)
                {
                  <span class="badge ml-2">Định kỳ</span>
                }
              </td>
              <td class="stat-number whitespace-nowrap px-5 py-3 text-right">@MoneyFormatter.Format(item.Amount)</td>
              <td class="whitespace-nowrap px-5 py-3 text-right">
                <div class="flex items-center justify-end gap-1">
                  <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-ghost px-3 py-1.5">Sửa</a>
                  <form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Xóa khoản chi này?">
                    <button type="submit" class="btn btn-ghost px-3 py-1.5 text-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    @* ----- Danh sách thẻ (mobile) ----- *@
    <ul class="mt-6 space-y-3 md:hidden">
      @foreach (var item in result.Items)
      {
        <li class="card p-4 sm:p-4">
          <div class="flex items-start justify-between gap-3">
            <partial name="_CategoryChip" model="new CategoryChipViewModel(item.CategoryName, item.CategoryColor, item.CategoryIcon)" />
            <span class="stat-number whitespace-nowrap">@MoneyFormatter.Format(item.Amount)</span>
          </div>
          <p class="mt-2 text-xs">@item.SpentAt.ToString("dd/MM/yyyy")</p>
          @if (!string.IsNullOrWhiteSpace(item.Note))
          {
            <p class="mt-1 text-sm">@item.Note</p>
          }
          @if (item.IsRecurring)
          {
            <span class="badge mt-2">Định kỳ</span>
          }
          <div class="mt-3 flex items-center gap-1">
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary px-3 py-1.5">Sửa</a>
            <form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Xóa khoản chi này?">
              <button type="submit" class="btn btn-ghost px-3 py-1.5 text-danger">Xóa</button>
            </form>
          </div>
        </li>
      }
    </ul>

    @* ----- Phân trang ----- *@
    @if (result.TotalPages > 1)
    {
      <nav class="mt-6 flex flex-wrap items-center justify-center gap-1" aria-label="Phân trang">
        @if (result.Page > 1)
        {
          <a href="@pageUrl(result.Page - 1)" class="btn btn-secondary px-3 py-1.5">‹ Trước</a>
        }
        @for (var p = firstPage; p <= lastPage; p++)
        {
          if (p == result.Page)
          {
            <span class="btn btn-primary px-3.5 py-1.5" aria-current="page">@p</span>
          }
          else
          {
            <a href="@pageUrl(p)" class="btn btn-ghost px-3.5 py-1.5">@p</a>
          }
        }
        @if (result.Page < result.TotalPages)
        {
          <a href="@pageUrl(result.Page + 1)" class="btn btn-secondary px-3 py-1.5">Sau ›</a>
        }
      </nav>
    }
  }
</section>
