@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<section class="min-h-[calc(100vh-4rem)] py-12 sm:py-20">
  <div class="container-app">
    <div class="card mx-auto max-w-md">
      <h1 class="text-2xl sm:text-3xl">Tạo Tài Khoản</h1>
      <p class="mt-1 text-sm">Bắt đầu theo dõi chi tiêu của bạn chỉ trong một phút.</p>

      <form asp-action="Register" method="post" class="mt-6 space-y-4" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

        <div>
          <label asp-for="DisplayName" class="label"></label>
          <input asp-for="DisplayName" class="input" autocomplete="name" placeholder="Nguyễn Văn A" />
          <span asp-validation-for="DisplayName" class="field-error"></span>
        </div>

        <div>
          <label asp-for="Email" class="label"></label>
          <input asp-for="Email" class="input" type="email" autocomplete="email" placeholder="ban@example.com" />
          <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div>
          <label asp-for="Password" class="label"></label>
          <input asp-for="Password" class="input" autocomplete="new-password" placeholder="••••••••" />
          <p class="mt-1.5 text-xs">Ít nhất 8 ký tự, gồm chữ thường và chữ số.</p>
          <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div>
          <label asp-for="ConfirmPassword" class="label"></label>
          <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" placeholder="••••••••" />
          <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-pill btn-lg w-full">Đăng ký</button>
      </form>

      <p class="mt-6 text-center text-sm">
        Đã có tài khoản?
        <a asp-action="Login" class="font-semibold text-primary hover:underline">Đăng nhập</a>
      </p>
    </div>
  </div>
</section>
