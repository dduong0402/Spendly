@{
    ViewData["Title"] = "Liên kết không hợp lệ";
}

<section class="min-h-[calc(100vh-4rem)] py-12 sm:py-20">
  <div class="container-app">
    <div class="card mx-auto max-w-md text-center">
      <h1 class="text-2xl sm:text-3xl">Liên Kết Không Hợp Lệ</h1>
      <p class="mt-3 text-sm">Liên kết đặt lại mật khẩu bị thiếu hoặc không đúng. Hãy yêu cầu một liên kết mới.</p>
      <a asp-action="ForgotPassword" class="btn btn-primary btn-pill mt-6">Yêu cầu liên kết mới</a>
    </div>
  </div>
</section>
