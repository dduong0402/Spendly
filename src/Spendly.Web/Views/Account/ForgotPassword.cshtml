@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="min-h-[calc(100vh-4rem)] py-12 sm:py-20">
  <div class="container-app">
    <div class="card mx-auto max-w-md">
      <h1 class="text-2xl sm:text-3xl">Quên Mật Khẩu</h1>
      <p class="mt-1 text-sm">Nhập email đăng ký, Spendly sẽ gửi liên kết để bạn đặt mật khẩu mới.</p>

      <form asp-action="ForgotPassword" method="post" class="mt-6 space-y-4" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

        <div>
          <label asp-for="Email" class="label"></label>
          <input asp-for="Email" class="input" type="email" autocomplete="email" placeholder="ban@example.com" />
          <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-pill btn-lg w-full">Gửi liên kết</button>
      </form>

      <p class="mt-6 text-center text-sm">
        <a asp-action="Login" class="font-semibold text-primary hover:underline">Quay lại đăng nhập</a>
      </p>
    </div>
  </div>
</section>
