@{
    ViewData["Title"] = "Đã đặt lại mật khẩu";
}

<section class="min-h-[calc(100vh-4rem)] py-12 sm:py-20">
  <div class="container-app">
    <div class="card mx-auto max-w-md text-center">
      <h1 class="text-2xl sm:text-3xl">Đã Đặt Lại Mật Khẩu</h1>
      <p class="mt-3 text-sm">Nếu liên kết còn hiệu lực, mật khẩu của bạn đã được đổi. Hãy đăng nhập bằng mật khẩu mới.</p>
      <a asp-action="Login" class="btn btn-primary btn-pill mt-6">Đăng nhập</a>
    </div>
  </div>
</section>
