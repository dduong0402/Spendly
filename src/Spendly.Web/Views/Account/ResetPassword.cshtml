@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="min-h-[calc(100vh-4rem)] py-12 sm:py-20">
  <div class="container-app">
    <div class="card mx-auto max-w-md">
      <h1 class="text-2xl sm:text-3xl">Đặt Lại Mật Khẩu</h1>
      <p class="mt-1 text-sm">Đặt mật khẩu mới cho <strong>@Model.Email</strong>.</p>

      <form asp-action="ResetPassword" method="post" class="mt-6 space-y-4" novalidate>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="All" class="alert-danger"></div>

        <div>
          <label asp-for="Password" class="label"></label>
          <input asp-for="Password" class="input" autocomplete="new-password" placeholder="Ít nhất 8 ký tự, có chữ và số" />
          <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div>
          <label asp-for="ConfirmPassword" class="label"></label>
          <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
          <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-pill btn-lg w-full">Đặt lại mật khẩu</button>
      </form>

      <p class="mt-6 text-center text-sm">
        Liên kết hết hạn?
        <a asp-action="ForgotPassword" class="font-semibold text-primary hover:underline">Yêu cầu liên kết mới</a>
      </p>
    </div>
  </div>
</section>
