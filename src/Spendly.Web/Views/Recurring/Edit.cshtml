@model RecurringFormViewModel
@{
    ViewData["Title"] = "Sửa khoản định kỳ";
    var detail = (RecurringExpenseDetail)ViewData["Detail"]!;
}

<section class="container-app py-10">
  <div class="card mx-auto max-w-lg">
    <h1 class="text-2xl">Sửa Khoản Chi Định Kỳ</h1>
    <form asp-action="Edit" asp-route-id="@detail.Id" method="post" class="mt-6 space-y-4" novalidate>
      <partial name="_RecurringFormFields" model="Model" view-data="ViewData" />
      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn btn-primary btn-pill">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary btn-pill">Hủy</a>
      </div>
    </form>
  </div>
</section>
