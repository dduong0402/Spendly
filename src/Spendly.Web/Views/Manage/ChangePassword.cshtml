@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="container-app py-10">
  <div class="card mx-auto max-w-lg">
    <h1 class="text-2xl">Đổi Mật Khẩu</h1>
    <form asp-action="ChangePassword" method="post" class="mt-6 space-y-4" novalidate>
      <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

      <div>
        <label asp-for="CurrentPassword" class="label"></label>
        <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
      </div>

      <div>
        <label asp-for="NewPassword" class="label"></label>
        <input asp-for="NewPassword" class="input" autocomplete="new-password" placeholder="Ít nhất 8 ký tự, có chữ và số" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
      </div>

      <div>
        <label asp-for="ConfirmPassword" class="label"></label>
        <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn btn-primary btn-pill">Đổi mật khẩu</button>
        <a asp-action="Index" class="btn btn-secondary btn-pill">Hủy</a>
      </div>
    </form>
  </div>
</section>
