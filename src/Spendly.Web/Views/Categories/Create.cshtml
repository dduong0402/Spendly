@model CategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
}

<section class="container-app py-10">
  <div class="card mx-auto max-w-lg">
    <h1 class="text-2xl">Thêm Danh Mục</h1>
    <form asp-action="Create" method="post" class="mt-6 space-y-4" novalidate>
      <partial name="_CategoryFormFields" model="Model" />
      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn btn-primary btn-pill">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary btn-pill">Hủy</a>
      </div>
    </form>
  </div>
</section>

@section Scripts {
  <script type="module" src="~/js/category-form.js" asp-append-version="true"></script>
}
